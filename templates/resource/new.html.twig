<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle ressource — (RE)Sources Relationnelles</title>
</head>
<body>

<div class="card">

    <div class="card-header">
        <div>
            <h1>Nouvelle ressource</h1>
            <p>(RE)Sources Relationnelles</p>
        </div>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="flash flash-info">ℹ️ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash flash-error">⚠️ {{ message }}</div>
    {% endfor %}

    <p class="required-note">Les champs marqués <strong>*</strong> sont obligatoires.</p>

    {# Formulaire #}
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

    {# Titre #}
    <div class="form-group">
        {{ form_label(form.titre) }} <strong>*</strong>
        {{ form_widget(form.titre) }}
        {{ form_errors(form.titre) }}
    </div>

    <div class="form-group">
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="form-group">
        {{ form_label(form.contenu) }}
        {{ form_widget(form.contenu) }}
        {{ form_errors(form.contenu) }}
    </div>

    <div class="form-group">
        {{ form_label(form.media) }}
        {{ form_widget(form.media) }}
        {{ form_errors(form.media) }}
        <p class="field-hint">Formats acceptés : JPG, PNG, MP4, MP3, WAV, PDF — 50 Mo max</p>
    </div>

    <div class="form-row">
        <div class="form-group">
            {{ form_label(form.typeRessource) }}
            {{ form_widget(form.typeRessource) }}
            {{ form_errors(form.typeRessource) }}
        </div>
        <div class="form-group">
            {{ form_label(form.visibilite) }}
            {{ form_widget(form.visibilite) }}
            {{ form_errors(form.visibilite) }}
        </div>
    </div>

    <div class="form-group">
        {{ form_label(form.category) }}
        {{ form_widget(form.category) }}
        {{ form_errors(form.category) }}
    </div>

    {{ form_widget(form.submit) }}

    {{ form_end(form) }}

</div>

</body>
</html>
