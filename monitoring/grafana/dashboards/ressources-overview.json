{
  "__inputs": [],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" }
  ],
  "annotations":  { "list": [] },
  "editable":     true,
  "graphTooltip": 1,
  "id":           null,
  "links":        [],
  "refresh":      "10s",
  "schemaVersion": 38,
  "tags":         ["symfony", "php-fpm", "mysql", "nginx", "loki"],
  "time":         { "from": "now-1h", "to": "now" },
  "timepicker":   {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"],
    "time_options":      ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "timezone":     "Europe/Paris",
  "title":        "Ressources Relationnelles — Overview",
  "uid":          "ressources-overview",
  "version":      5,

  "panels": [

    {
      "id": 100, "type": "row", "title": "🌐 HTTP Traffic",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 1, "type": "stat", "title": "Requêtes / seconde",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(rate({job=\"nginx-access\"}[1m]))",
        "legendFormat": "req/s"
      }]
    },

    {
      "id": 2, "type": "stat", "title": "Taux d'erreur 5xx",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(rate({job=\"nginx-access\", status=~\"5..\"}[1m])) / sum(rate({job=\"nginx-access\"}[1m])) * 100",
        "legendFormat": "5xx %"
      }]
    },

    {
      "id": 3, "type": "stat", "title": "Latence P95",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 2.0 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum(rate(promtail_custom_http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "P95"
      }]
    },

    {
      "id": 4, "type": "stat", "title": "Connexions Nginx actives",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 500 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "nginx_connections_active",
        "legendFormat": "Actives"
      }]
    },

    {
      "id": 5, "type": "stat", "title": "Erreurs 4xx / seconde",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(rate({job=\"nginx-access\", status=~\"4..\"}[1m]))",
        "legendFormat": "4xx/s"
      }]
    },

    {
      "id": 6, "type": "stat", "title": "Bande passante sortante",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(promtail_custom_http_response_size_bytes_sum[1m]))",
        "legendFormat": "bytes/s"
      }]
    },

    {
      "id": 101, "type": "row", "title": "📊 Requêtes HTTP détaillées",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 7, "type": "timeseries", "title": "Requêtes / seconde par code HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({job=\"nginx-access\", status=~\"2..\"}[1m]))", "legendFormat": "2xx" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({job=\"nginx-access\", status=~\"3..\"}[1m]))", "legendFormat": "3xx" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({job=\"nginx-access\", status=~\"4..\"}[1m]))", "legendFormat": "4xx" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(rate({job=\"nginx-access\", status=~\"5..\"}[1m]))", "legendFormat": "5xx" }
      ]
    },

    {
      "id": 8, "type": "timeseries", "title": "Latence P50 / P95 / P99",
      "description": "Histogrammes Promtail → Prometheus. Buckets: 50ms 100ms 250ms 500ms 1s 2.5s 5s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "decimals": 3, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum(rate(promtail_custom_http_request_duration_seconds_bucket[2m])) by (le))", "legendFormat": "P50" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(promtail_custom_http_request_duration_seconds_bucket[2m])) by (le))", "legendFormat": "P95" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(promtail_custom_http_request_duration_seconds_bucket[2m])) by (le))", "legendFormat": "P99" }
      ]
    },

    {
      "id": 9, "type": "timeseries", "title": "Requêtes lentes (> 1s) et très lentes (> 5s)",
      "description": "Calculé via complément des buckets Prometheus : total − bucket{le=N}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(promtail_custom_http_request_duration_seconds_count[1m])) - sum(rate(promtail_custom_http_request_duration_seconds_bucket{le=\"1\"}[1m])), 0)",
          "legendFormat": "> 1s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(promtail_custom_http_request_duration_seconds_count[1m])) - sum(rate(promtail_custom_http_request_duration_seconds_bucket{le=\"5\"}[1m])), 0)",
          "legendFormat": "> 5s"
        }
      ]
    },

    {
      "id": 10, "type": "timeseries", "title": "Taille des réponses HTTP (bytes/s)",
      "description": "Calculé depuis promtail_custom_http_response_size_bytes (Prometheus)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(promtail_custom_http_response_size_bytes_sum[1m]))",                     "legendFormat": "Total"           },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (method) (rate(promtail_custom_http_response_size_bytes_sum[1m]))",         "legendFormat": "{{method}}"      },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (exported_status) (rate(promtail_custom_http_response_size_bytes_sum[1m]))", "legendFormat": "HTTP {{exported_status}}" }
      ]
    },

    {
      "id": 102, "type": "row", "title": "⚙️ PHP-FPM",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },

    {
      "id": 11, "type": "timeseries", "title": "PHP-FPM — Workers actifs / inactifs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "phpfpm_active_processes",           "legendFormat": "Actifs"               },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "phpfpm_idle_processes",             "legendFormat": "Inactifs"             },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "phpfpm_max_children_reached_total", "legendFormat": "Max children atteint" }
      ]
    },

    {
      "id": 12, "type": "timeseries", "title": "PHP-FPM — Connexions / seconde",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(phpfpm_accepted_connections_total[1m])", "legendFormat": "Connexions/s"    },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(phpfpm_slow_requests_total[1m])",        "legendFormat": "Slow requests/s" }
      ]
    },

    {
      "id": 103, "type": "row", "title": "🗄️ MySQL",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },

    {
      "id": 13, "type": "timeseries", "title": "MySQL — Requêtes / seconde",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(mysql_global_status_queries[1m])",      "legendFormat": "Requêtes/s"     },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(mysql_global_status_slow_queries[1m])", "legendFormat": "Slow queries/s" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(mysql_global_status_questions[1m])",    "legendFormat": "Questions/s"    }
      ]
    },

    {
      "id": 14, "type": "timeseries", "title": "MySQL — Connexions & threads",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "mysql_global_status_threads_connected",    "legendFormat": "Connectés"     },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "mysql_global_status_threads_running",      "legendFormat": "En cours"      },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "mysql_global_status_max_used_connections", "legendFormat": "Max utilisées" }
      ]
    },

    {
      "id": 104, "type": "row", "title": "🖥️ Système",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }
    },

    {
      "id": 15, "type": "timeseries", "title": "CPU — Utilisation %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",  "legendFormat": "CPU total %" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "avg(rate(node_cpu_seconds_total{mode=\"user\"}[2m])) * 100",          "legendFormat": "User %"      },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "avg(rate(node_cpu_seconds_total{mode=\"system\"}[2m])) * 100",        "legendFormat": "System %"    },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[2m])) * 100",        "legendFormat": "IOWait %"    }
      ]
    },

    {
      "id": 16, "type": "timeseries", "title": "Mémoire — Utilisation",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_memory_MemTotal_bytes",                                  "legendFormat": "Total"      },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Utilisée"   },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_memory_MemAvailable_bytes",                              "legendFormat": "Disponible" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_memory_Cached_bytes",                                    "legendFormat": "Cache"      }
      ]
    },

    {
      "id": 105, "type": "row", "title": "📋 Logs en temps réel",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 }
    },

    {
      "id": 17, "type": "logs", "title": "Erreurs HTTP (4xx / 5xx) — temps réel",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 50 },
      "options": {
        "dedupStrategy": "none", "enableLogDetails": true,
        "prettifyLogMessage": true, "showCommonLabels": false,
        "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{job=\"nginx-access\", status=~\"[45]..\"}",
        "legendFormat": ""
      }]
    },

    {
      "id": 18, "type": "logs", "title": "Tous les logs Nginx — temps réel",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 60 },
      "options": {
        "dedupStrategy": "signature", "enableLogDetails": true,
        "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{job=\"nginx-access\"}",
        "legendFormat": ""
      }]
    }

  ]
}
